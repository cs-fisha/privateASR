ASR_URL=https://asr.example.com
ASR_TOKEN=replace-with-the-same-token
ASR_LANGUAGE=zh
ASR_SAMPLE_RATE=16000
ASR_RECORD_HOTKEY=ctrl+alt+space
ASR_CORRECTION_HOTKEY=ctrl+alt+p
ASR_REQUEST_TIMEOUT=900
# Set false to start with secondary correction disabled. Ctrl+Alt+P toggles it at runtime.
ASR_ENABLE_CORRECTION=true
# GUI settings are persisted here by default: %LOCALAPPDATA%\ASR\config.json
ASR_CONFIG_FILE=
# Comma/space-separated terms that should be preserved accurately.
ASR_HOTWORDS=Python,FastAPI,Docker,WireGuard,GitHub,CUDA,VS Code
ASR_LOG_FILE=
