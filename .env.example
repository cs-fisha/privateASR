ASR_API_TOKEN=replace-with-a-long-random-token
# GPU URL is reachable through WireGuard, e.g. http://10.66.0.2:8080
ASR_GPU_URL=
ASR_ENGINE=faster-whisper
ASR_MODEL=iic/SenseVoiceSmall
ASR_WHISPER_MODEL=small
ASR_DEFAULT_LANGUAGE=zh
ASR_REMOVE_FILLERS=true
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_FUNASR_VAD_MODEL=fsmn-vad
ASR_FUNASR_MAX_SEGMENT_MS=30000
ASR_WHISPER_BEAM_SIZE=5
ASR_PORT=45679
ASR_BIND=127.0.0.1
ASR_RESTART_POLICY=unless-stopped
ASR_HEALTH_INTERVAL=30s
ASR_HEALTH_TIMEOUT=5s
ASR_HEALTH_RETRIES=3
ASR_MAX_BYTES=26214400
ASR_GPU_TIMEOUT=180
# Optional OpenAI-compatible /v1 endpoint for punctuation and technical-term correction.
ASR_CORRECTOR_URL=
ASR_CORRECTOR_MODEL=
ASR_CORRECTOR_KEY=
ASR_CORRECTOR_PROMPT=Correct ASR punctuation and obvious technical terms. Preserve code, English identifiers, and meaning. Return only corrected text. 如果输入是大于一百字的长文本，请理解原意后在不偏离原意太多和不增加太多篇幅的前提下，整体对文本进行润色，确保语义通顺、逻辑清晰、表达自然。
ASR_CORRECTOR_TIMEOUT=60
ASR_CORRECTOR_TEMPERATURE=0
# Enable when a local corrector hostname resolves to an unusable IPv6 address first.
ASR_CORRECTOR_FORCE_IPV4=false
ASR_INFERENCE_TIMEOUT=300
# Optional, e.g. http://host.docker.internal:7890
ASR_PROXY=
ASR_PYTHON_MIRROR=docker.m.daocloud.io/library/python:3.11-slim
NO_PROXY=localhost,127.0.0.1
